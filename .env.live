# Build for the real domain: `npm run build:live` (astro build --mode live).
# Loaded on top of .env and wins over it. Indexable, but the illustrative example content stays on
# (client's decision, 2026-11-06). The pages.dev addresses stay noindex through public/_headers.
# PUBLIC_PLAN is left unset on purpose: set it to the plan the client chooses (base | formulario | sanity).
# Until then build:live fails (a form plan needs a real Turnstile key for www.carretolages.com).
PUBLIC_DESIGN_PREVIEW=true
PUBLIC_NOINDEX=false
