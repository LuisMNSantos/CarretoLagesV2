---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../shared/PageHero.astro';
import Blocks from '../shared/Blocks.astro';
import CtaBand from '../shared/CtaBand.astro';
import Icon from '../shared/Icon.astro';
import { areaById, tr, type Lawyer } from '../../lib/content';
import { imageSource } from '../../lib/images';
import { initials } from '../../lib/initials';
import { localizePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/locale';

export interface Props { locale: Locale; lawyer: Lawyer; jsonLd?: object[] }
const { locale, lawyer, jsonLd } = Astro.props;
const areaList = lawyer.areas.map((id) => areaById(id)).filter((a) => a !== undefined);
const surname = lawyer.name.split(' ').at(-1) ?? lawyer.name;
---
<Base
  locale={locale}
  title={`${lawyer.name} — ${tr(lawyer.role, locale)} — Carreto Lages & Associados`}
  description={`${lawyer.name}, ${tr(lawyer.role, locale)} — Carreto Lages & Associados.`}
  alternates={{ pt: localizePath('lawyers', 'pt', lawyer.slug), en: localizePath('lawyers', 'en', lawyer.slug) }}
  jsonLd={jsonLd}
  headerVariant="overlay"
>
  <PageHero
    locale={locale}
    variant="feature"
    eyebrow={tr(lawyer.role, locale)}
    title={[lawyer.name]}
    watermark={surname}
    crumbs={[{ label: t(locale, 'nav.lawyers'), href: localizePath('lawyers', locale) }, { label: lawyer.name }]}
  >
    {areaList.length > 0 && (
      <ul class="mt-8 flex flex-wrap gap-2">
        {areaList.map((a) => <li><a href={localizePath('areas', locale, tr(a.slug, locale))} class="inline-flex min-h-9 items-center rounded-full border border-marfim/30 px-3.5 text-sm text-marfim hover:border-marfim">{tr(a.title, locale)}</a></li>)}
      </ul>
    )}
    <div class="mt-8 flex flex-wrap gap-4">
      <a href={`mailto:${lawyer.email}`} class="btn btn-bronze"><Icon name="mail" size={16} />{t(locale, 'team.contactLawyer')} {lawyer.name.split(' ')[0]}</a>
      {lawyer.linkedin && <a href={lawyer.linkedin} class="btn btn-ghost-light" rel="noopener" target="_blank">LinkedIn<Icon name="arrow-up-right" size={14} /></a>}
    </div>
    <Fragment slot="card">
      {lawyer.photo ? (
        <Picture {...imageSource(lawyer.photo, 'team')} alt={lawyer.name} widths={[480, 720, 960]} sizes="(min-width: 768px) 38vw, 92vw" formats={['avif', 'webp']} quality={70} loading="eager" class="h-full w-full object-cover object-top" />
      ) : (
        <div class="grid h-full place-items-center bg-gradient-to-br from-areia to-areia-escura" role="img" aria-label={lawyer.name}>
          <span class="font-logo text-[6rem] tracking-[0.06em] text-verde-700/80" aria-hidden="true">{initials(lawyer.name)}</span>
        </div>
      )}
    </Fragment>
  </PageHero>

  <section class="pb-20 pt-14 md:pb-28 md:pt-12" aria-labelledby="bio-title">
    <div class="container-site md:grid md:grid-cols-12">
      <div class="md:col-span-7">
        <h2 id="bio-title" class="eyebrow text-tinta-suave">{t(locale, 'team.bio')}</h2>
        <Blocks blocks={lawyer.bio} locale={locale} class="mt-6" />
      </div>
    </div>
  </section>
  <CtaBand locale={locale} />
</Base>
