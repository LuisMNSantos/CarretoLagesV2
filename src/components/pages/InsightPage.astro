---
import Base from '../../layouts/Base.astro';
import Blocks from '../shared/Blocks.astro';
import CtaBand from '../shared/CtaBand.astro';
import CopyLink from '../shared/CopyLink.astro';
import PlaceholderBadge from '../shared/PlaceholderBadge.astro';
import ReadingHeader from '../shared/ReadingHeader.astro';
import { areaById, tr, type Insight } from '../../lib/content';
import { localizePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/locale';

export interface Props { locale: Locale; item: Insight }
const { locale, item } = Astro.props;
const area = item.area ? areaById(item.area) : undefined;
---
<Base
  locale={locale}
  title={`${tr(item.title, locale)} — Carreto Lages & Associados`}
  description={tr(item.excerpt, locale)}
  alternates={{ pt: localizePath('insights', 'pt', item.slug.pt), en: item.slug.en ? localizePath('insights', 'en', item.slug.en) : undefined }}
 headerVariant="overlay">
  <article>
    <ReadingHeader
      locale={locale}
      eyebrow={area ? tr(area.title, locale) : t(locale, 'insights.eyebrow')}
      title={tr(item.title, locale)}
      lead={tr(item.excerpt, locale)}
      date={item.date}
      minutes={item.readingMinutes}
      image={item.image}
      watermark={locale === 'pt' ? 'Destaques' : 'Insights'}
      crumbs={[{ label: t(locale, 'nav.insights'), href: localizePath('insights', locale) }]}
    >
      {item.placeholder && <PlaceholderBadge locale={locale} />}
    </ReadingHeader>
    <div class="container-site pb-20 pt-14 md:pt-12">
      <Blocks blocks={item.body} locale={locale} />
      <div class="mt-12"><CopyLink locale={locale} /></div>
    </div>
  </article>
  <CtaBand locale={locale} />
</Base>
