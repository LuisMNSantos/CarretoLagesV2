---
import Base from '../../layouts/Base.astro';
import Hero from '../home/Hero.astro';
import AreasCarousel from '../home/AreasCarousel.astro';
import Situations from '../home/Situations.astro';
import Process from '../home/Process.astro';
import TeamTeaser from '../home/TeamTeaser.astro';
import Anniversary from '../home/Anniversary.astro';
import CasesTeaser from '../home/CasesTeaser.astro';
import Testimonials from '../home/Testimonials.astro';
import Faq from '../shared/Faq.astro';
import ContactSection from '../shared/ContactSection.astro';
import { settings, tr } from '../../lib/content';
import { localizePath } from '../../i18n/routes';
import type { Locale } from '../../i18n/locale';

export interface Props { locale: Locale; jsonLd?: object[] }
const { locale, jsonLd } = Astro.props;
---
<Base
  locale={locale}
  title={tr(settings.seo.homeTitle, locale)}
  description={tr(settings.seo.homeDescription, locale)}
  alternates={{ pt: localizePath('home', 'pt'), en: localizePath('home', 'en') }}
  headerVariant="overlay"
  jsonLd={jsonLd}
>
  <Hero locale={locale} />
  <AreasCarousel locale={locale} />
  <Situations locale={locale} />
  <Process locale={locale} />
  <Anniversary locale={locale} />
  <TeamTeaser locale={locale} />
  <CasesTeaser locale={locale} />
  <Testimonials locale={locale} />
  <Faq locale={locale} />
  <ContactSection locale={locale} />
</Base>
