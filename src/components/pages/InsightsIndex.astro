---
import Base from '../../layouts/Base.astro';
import PageHero from '../shared/PageHero.astro';
import StockImage from '../shared/StockImage.astro';
import PlaceholderBadge from '../shared/PlaceholderBadge.astro';
import CtaBand from '../shared/CtaBand.astro';
import Icon from '../shared/Icon.astro';
import { insights, tr, visible } from '../../lib/content';
import { localizePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/locale';
import { allRoutes } from '../../lib/all-routes';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const list = visible(insights, locale);
const alt = allRoutes().find((r) => r.path === localizePath('insights', locale))?.alternates ?? {};
const fmt = new Intl.DateTimeFormat(locale === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'long' });
const title: [string, string] = locale === 'pt' ? ['Notas claras', 'sobre o que muda.'] : ['Clear notes', 'on what is changing.'];
---
<Base locale={locale} title={`${t(locale, 'nav.insights')} — Carreto Lages & Associados`} description={`${title[0]} ${title[1]}`} alternates={alt}>
  <PageHero locale={locale} eyebrow={t(locale, 'insights.eyebrow')} title={title} crumbs={[{ label: t(locale, 'nav.insights') }]} />
  <section class="pb-24">
    <div class="container-site">
      <ul class="grid gap-6 md:grid-cols-2">
        {list.map((a) => (
          <li>
            <a href={localizePath('insights', locale, tr(a.slug, locale))} class="card group flex h-full flex-col overflow-hidden transition-colors hover:bg-areia">
              <div class="aspect-[16/9]"><StockImage id={a.image} sizes="(min-width: 768px) 45vw, 92vw" /></div>
              <div class="flex flex-1 flex-col p-7 md:p-8">
                <div class="flex flex-wrap items-center gap-3 text-sm text-tinta-suave">
                  <time datetime={a.date}>{fmt.format(new Date(a.date))}</time><span>· {a.readingMinutes} min</span>
                  {a.placeholder && <PlaceholderBadge locale={locale} />}
                </div>
                <h2 class="mt-5 text-[1.625rem] leading-tight text-tinta">{tr(a.title, locale)}</h2>
                <p class="mt-3 text-[0.9375rem] leading-relaxed text-tinta-suave">{tr(a.excerpt, locale)}</p>
                <span class="link-arrow mt-auto self-start pt-6 text-verde-700">{t(locale, 'cta.readMore')}<Icon name="arrow-up-right" size={14} /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand locale={locale} />
</Base>
