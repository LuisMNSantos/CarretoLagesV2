---
import { noindex } from '../../lib/env';

export interface Props {
  locale: 'pt' | 'en';
  title: string;
  description: string;
  alternates: { pt?: string | undefined; en?: string | undefined };
  jsonLd?: object[] | undefined;
  ogImage?: string | undefined;
}

const { locale, title, description, alternates, jsonLd = [], ogImage } = Astro.props;
const site = Astro.site ?? new URL('https://carretolages-v2.pages.dev');
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(Astro.url.pathname);
const ogLocale = locale === 'pt' ? 'pt_PT' : 'en_GB';
const image = abs(ogImage ?? '/og-image.jpg');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.pt && <link rel="alternate" hreflang="pt-PT" href={abs(alternates.pt)} />}
{alternates.en && <link rel="alternate" hreflang="en" href={abs(alternates.en)} />}
{alternates.pt && <link rel="alternate" hreflang="x-default" href={abs(alternates.pt)} />}
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta name="theme-color" content="#0F241D" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Carreto Lages & Associados" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
{jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
