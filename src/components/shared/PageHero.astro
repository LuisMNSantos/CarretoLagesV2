---
import StockImage from './StockImage.astro';
import Icon from './Icon.astro';
import { localizePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/locale';

export interface Props {
  locale: Locale;
  eyebrow: string;
  title: [string, string] | [string];
  lead?: string | undefined;
  image?: string | undefined;
  crumbs?: { label: string; href?: string }[];
}
const { locale, eyebrow, title, lead, image, crumbs = [] } = Astro.props;
---
<section class="pb-14 pt-10 md:pb-20 md:pt-16" aria-labelledby="page-title">
  <div class="container-site">
    {crumbs.length > 0 && (
      <nav aria-label={t(locale, 'breadcrumb.label')} class="mb-10 text-[0.8125rem] text-tinta-suave">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a class="hover:text-verde-700" href={localizePath('home', locale)}>{t(locale, 'nav.home')}</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <Icon name="arrow-right" size={12} class="opacity-50" />
              {c.href ? <a class="hover:text-verde-700" href={c.href}>{c.label}</a> : <span aria-current="page" class="text-tinta">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="grid gap-10 md:grid-cols-12 md:items-end">
      <div class:list={[image ? 'md:col-span-7' : 'md:col-span-9']}>
        <p class="eyebrow text-tinta-suave">{eyebrow}</p>
        <h1 id="page-title" class="mt-6 text-[clamp(2.4rem,4.8vw,4.25rem)] text-tinta">
          {title.map((line) => <span class="block">{line}</span>)}
        </h1>
        {lead && <p class="lead mt-7 max-w-2xl text-tinta-suave">{lead}</p>}
        <slot />
      </div>
      {image && (
        <div class="aspect-[4/3] overflow-hidden rounded-md md:col-span-5">
          <StockImage id={image} sizes="(min-width: 768px) 40vw, 92vw" loading="eager" />
        </div>
      )}
    </div>
  </div>
</section>
