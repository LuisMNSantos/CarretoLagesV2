---
import { Picture } from 'astro:assets';
import { imageSource } from '../../lib/images';
import type { ImageRef } from '../../lib/content';
export interface Props {
  id: ImageRef;
  alt?: string;
  sizes: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  widths?: number[];
}
const { id, alt = '', sizes, class: cls = '', loading = 'lazy', widths = [480, 800, 1200, 1600] } = Astro.props;
---
<Picture
  {...imageSource(id, 'stock')}
  alt={alt}
  sizes={sizes}
  widths={widths}
  formats={['avif', 'webp']}
  quality={60}
  loading={loading}
  decoding="async"
  class:list={['img-tone h-full w-full object-cover', cls]}
/>
