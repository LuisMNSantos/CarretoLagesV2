---
/** Header for reading pages (case studies, insights): the "feature" page hero plus date and badges. */
import PageHero from './PageHero.astro';
import type { Locale } from '../../i18n/locale';

export interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  lead: string;
  date: string;
  minutes?: number | undefined;
  image?: string | undefined;
  watermark?: string | undefined;
  crumbs: { label: string; href: string }[];
}
const { locale, eyebrow, title, lead, date, minutes, image, watermark, crumbs } = Astro.props;
const formatted = new Intl.DateTimeFormat(locale === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'long' }).format(new Date(date));
---
<PageHero locale={locale} variant="feature" eyebrow={eyebrow} title={[title]} lead={lead} image={image} watermark={watermark} crumbs={crumbs}>
  <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-marfim/80">
    <span><time datetime={date}>{formatted}</time>{minutes && <span> · {minutes} min</span>}</span>
    <slot />
  </div>
</PageHero>
