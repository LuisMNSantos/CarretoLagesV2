---
import ContactForm from './ContactForm.astro';
import MapEmbed from './MapEmbed.astro';
import StockImage from './StockImage.astro';
import Icon from './Icon.astro';
import { offices, settings, tr, visible } from '../../lib/content';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/locale';

export interface Props { locale: Locale; preselectArea?: string | undefined; headingLevel?: 'h1' | 'h2'; showOffices?: boolean }
const { locale, preselectArea, headingLevel: H = 'h2', showOffices = true } = Astro.props;
const list = visible(offices, locale);
---
<section id="contacto" class="bg-areia/60 py-20 md:py-28" aria-labelledby="contact-title">
  <div class="container-site">
    <div class="grid overflow-hidden rounded-md bg-marfim lg:grid-cols-12">
      <figure class="relative hidden min-h-[22rem] lg:col-span-5 lg:block">
        <StockImage id="office-corridor" sizes="40vw" />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-verde-900/80 to-transparent p-6 pt-20 text-[0.6875rem] uppercase tracking-[0.22em] text-marfim">
          {locale === 'pt' ? 'Espaço para uma melhor conversa.' : 'Space for a better conversation.'}
        </figcaption>
      </figure>
      <div class="p-7 sm:p-10 lg:col-span-7 lg:p-14">
        <p class="eyebrow text-tinta-suave">{t(locale, 'nav.contact')}</p>
        <H id="contact-title" class="display-2 mt-5 text-tinta">
          <span class="block">{t(locale, 'form.title1')}</span>
          <span class="block">{t(locale, 'form.title2')}</span>
        </H>
        <p class="mt-5 max-w-lg text-[0.9375rem] leading-relaxed text-tinta-suave">{t(locale, 'form.lead')}</p>
        <div class="mt-10"><ContactForm locale={locale} preselectArea={preselectArea} /></div>
      </div>
    </div>

    {showOffices && (
      <div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-8">
        {list.map((o) => (
          <div>
            <MapEmbed office={o} locale={locale} />
            <h3 class="mt-6 text-[1.5rem] text-tinta">{o.name}</h3>
            <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-tinta-suave">
              <li class="flex items-start gap-2"><Icon name="pin" size={16} class="mt-1 shrink-0" />{tr(o.address, locale)}</li>
              <li><a class="inline-flex items-center gap-2 hover:text-verde-700" href={settings.phoneHref}><Icon name="phone" size={16} />{o.phone}</a></li>
              <li class="flex items-center gap-2"><Icon name="clock" size={16} />{tr(settings.hours, locale)}</li>
            </ul>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
