---
import { Picture } from 'astro:assets';
import { teamPhoto } from '../../lib/images';
import { initials } from '../../lib/initials';
import { tr, type Lawyer } from '../../lib/content';
import { localizePath } from '../../i18n/routes';
import type { Locale } from '../../i18n/locale';
export interface Props { lawyer: Lawyer; locale: Locale; size?: 'lg' | 'sm' }
const { lawyer, locale, size = 'lg' } = Astro.props;
---
<!-- Photo card with the role and name written inside the image, on a soft dark gradient. -->
<a href={localizePath('lawyers', locale, lawyer.slug)} class="lawyer-card group block" data-lawyer={lawyer.slug}>
  <div class="relative aspect-[4/5] overflow-hidden rounded-lg bg-areia" data-lawyer-media>
    {lawyer.photo ? (
      <Picture
        src={teamPhoto(lawyer.photo)}
        alt=""
        widths={[320, 480, 720]}
        sizes={size === 'lg' ? '(min-width: 768px) 30vw, 90vw' : '(min-width: 768px) 22vw, 45vw'}
        formats={['avif', 'webp']}
        quality={65}
        loading="lazy"
        class="h-full w-full object-cover object-top grayscale-[20%] transition-transform duration-700 group-hover:scale-[1.04]"
      />
    ) : (
      <div class="grid h-full w-full place-items-center bg-gradient-to-b from-areia to-areia-escura pb-16" aria-hidden="true">
        <span class="font-logo text-[clamp(2.75rem,6vw,4.5rem)] tracking-[0.06em] text-verde-700/70">{initials(lawyer.name)}</span>
      </div>
    )}
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-verde-900/90 via-verde-900/55 to-transparent px-4 pb-5 pt-16 text-center text-marfim">
      <p class="mx-auto inline-block rounded-full bg-marfim/15 px-3 py-1 text-[0.6875rem] font-medium uppercase tracking-[0.14em] backdrop-blur-sm">{tr(lawyer.role, locale)}</p>
      <p class:list={['mt-2 font-medium leading-tight', size === 'lg' ? 'text-[1.25rem]' : 'text-[1.0625rem]']}>{lawyer.name}</p>
    </div>
  </div>
</a>
<style>
  :global(.lawyer-card picture) { display: block; height: 100%; }
</style>
