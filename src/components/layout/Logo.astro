---
import type { Locale } from '../../i18n/locale';
import { localizePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
export interface Props { locale: Locale; class?: string }
const { locale, class: cls = '' } = Astro.props;
---
<a href={localizePath('home', locale)} class:list={['logo inline-flex shrink-0 items-center gap-3 whitespace-nowrap', cls]}>
  <svg class="logo-mark" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true" focusable="false">
    <path d="M21 7.5A9.5 9.5 0 1 0 21 22.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
    <path d="M17 6v18h7" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="leading-none">
    <span class="block font-logo text-[1.35rem] font-medium tracking-[0.06em]">CARRETO LAGES</span>
    <span class="mt-1 block text-[0.5625rem] font-medium uppercase tracking-[0.32em] opacity-75">&amp; Associados · Advogados</span>
  </span>
  <span class="sr-only">— {t(locale, 'nav.home')}</span>
</a>
