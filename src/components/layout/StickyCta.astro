---
import Icon from '../shared/Icon.astro';
import { settings } from '../../lib/content';
import { localizePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/locale';
export interface Props { locale: Locale }
const { locale } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const href = path === localizePath('home', locale) ? '#contacto' : `${localizePath('contact', locale)}#contacto`;
---
<!-- Compact floating actions (phones/tablets): two small round buttons, bottom-right. -->
<div class="sticky-cta fixed bottom-4 right-4 z-40 flex items-center gap-2 xl:hidden" data-sticky-cta data-hidden="false">
  <a href={settings.phoneHref} class="sticky-btn bg-marfim text-verde-700" aria-label={`${t(locale, 'cta.call')} ${settings.phone}`}>
    <Icon name="phone" size={19} />
  </a>
  <a href={href} class="sticky-btn bg-verde-700 text-marfim" aria-label={t(locale, 'cta.contact')}>
    <Icon name="mail" size={19} />
  </a>
</div>
<style>
  .sticky-cta {
    margin-bottom: env(safe-area-inset-bottom);
    transition: transform 300ms var(--ease-calm), opacity 300ms var(--ease-calm);
  }
  .sticky-cta[data-hidden='true'] { transform: translateY(140%); opacity: 0; pointer-events: none; }
  .sticky-btn {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid rgb(27 58 47 / 0.18);
    box-shadow: 0 10px 24px -12px rgb(15 36 29 / 0.55);
  }
</style>
