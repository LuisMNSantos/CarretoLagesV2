---
/** 20th-anniversary section featuring the firm's crystal trophy (2002 → 2022). */
import { Picture } from 'astro:assets';
import trophy from '../../assets/brand/trofeu.png';
import Icon from '../shared/Icon.astro';
import { localizePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/locale';

export interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="anniversary on-dark relative isolate overflow-hidden bg-verde-900 py-20 text-marfim md:py-28" aria-labelledby="anniversary-title">
  <div class="anniversary-glow absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-site grid items-center gap-12 md:grid-cols-12 md:gap-16">
    <figure class="relative md:col-span-6" data-reveal>
      <div class="absolute inset-0 hidden translate-x-[14px] translate-y-[14px] rounded-xl border border-bronze/70 md:block" aria-hidden="true"></div>
      <div class="relative aspect-square overflow-hidden rounded-xl shadow-[0_30px_60px_-30px_rgb(0_0_0_/_0.7)]">
        <Picture
          src={trophy}
          alt={t(locale, 'anniversary.alt')}
          widths={[480, 720, 1000]}
          sizes="(min-width: 768px) 45vw, 92vw"
          formats={['avif', 'webp']}
          quality={68}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
    </figure>
    <div class="md:col-span-6" data-reveal>
      <p class="eyebrow text-bronze-claro">{t(locale, 'anniversary.eyebrow')}</p>
      <h2 id="anniversary-title" class="display-2 mt-5">
        <span class="block">{t(locale, 'anniversary.title1')}</span>
        <span class="block">{t(locale, 'anniversary.title2')}</span>
      </h2>
      <p class="mt-6 max-w-lg text-[1.0625rem] leading-relaxed text-marfim/85">{t(locale, 'anniversary.body')}</p>
      <dl class="mt-10 grid max-w-md grid-cols-2 border-t border-marfim/20">
        <div class="py-5 pr-4">
          <dt class="text-xs uppercase tracking-[0.18em] text-marfim/70">{t(locale, 'anniversary.since')}</dt>
          <dd class="mt-1 text-[2.25rem] font-light leading-none">2002 — 2022</dd>
        </div>
        <div class="border-l border-marfim/20 py-5 pl-6">
          <dt class="text-xs uppercase tracking-[0.18em] text-marfim/70">{t(locale, 'contact.offices')}</dt>
          <dd class="mt-2 text-[1.0625rem]">{t(locale, 'anniversary.offices')}</dd>
        </div>
      </dl>
      <a href={localizePath('history', locale)} class="link-arrow mt-8 text-bronze-claro">{t(locale, 'anniversary.link')}<Icon name="arrow-up-right" size={14} /></a>
    </div>
  </div>
</section>

<style>
  .anniversary-glow {
    background:
      radial-gradient(70% 80% at 15% 50%, rgb(170 141 115 / 0.16) 0%, rgb(15 36 29 / 0) 60%),
      repeating-linear-gradient(90deg, rgb(243 240 232 / 0.03) 0 1px, transparent 1px 96px);
  }
  .anniversary :global(picture) { display: block; height: 100%; }
</style>
