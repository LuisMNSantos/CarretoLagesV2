---
import LawyerPage from '../../../components/pages/LawyerPage.astro';
import { lawyers, visible } from '../../../lib/content';
import { pageJsonLd } from '../../../lib/page-jsonld';

export function getStaticPaths() {
  return visible(lawyers, 'en').map((x) => ({ params: { slug: x.slug }, props: { x } }));
}
const { x } = Astro.props;
---
<LawyerPage locale="en" lawyer={x} jsonLd={pageJsonLd('lawyers', x, 'en')} />
