---
import CasePage from '../../../components/pages/CasePage.astro';
import { cases, visible } from '../../../lib/content';

export function getStaticPaths() {
  return visible(cases, 'en').map((x) => ({ params: { slug: x.slug.en! }, props: { x } }));
}
const { x } = Astro.props;
---
<CasePage locale="en" item={x} />
