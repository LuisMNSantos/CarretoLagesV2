---
import InsightPage from '../../../components/pages/InsightPage.astro';
import { insights, visible } from '../../../lib/content';

export function getStaticPaths() {
  return visible(insights, 'en').map((x) => ({ params: { slug: x.slug.en! }, props: { x } }));
}
const { x } = Astro.props;
---
<InsightPage locale="en" item={x} />
