---
import '../styles/global.css';
import Head from '../components/seo/Head.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import StickyCta from '../components/layout/StickyCta.astro';
import { plan } from '../lib/env';

export interface Props {
  locale: 'pt' | 'en';
  title: string;
  description: string;
  alternates: { pt?: string | undefined; en?: string | undefined };
  headerVariant?: 'overlay' | 'solid';
  jsonLd?: object[] | undefined;
  ogImage?: string | undefined;
}

const { locale, title, description, alternates, headerVariant = 'solid', jsonLd, ogImage } = Astro.props;
const skip = locale === 'pt' ? 'Saltar para o conteúdo' : 'Skip to content';
---
<!doctype html>
<html lang={locale === 'pt' ? 'pt-PT' : 'en'} data-header={headerVariant} data-plan={plan}>
  <head>
    <Head locale={locale} title={title} description={description} alternates={alternates} jsonLd={jsonLd} ogImage={ogImage} />
  </head>
  <body id="top" class="min-h-dvh flex flex-col">
    <a class="skip-link" href="#conteudo">{skip}</a>
    <Header locale={locale} alternates={alternates} variant={headerVariant} />
    <main id="conteudo" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer locale={locale} alternates={alternates} />
    <StickyCta locale={locale} />
  </body>
</html>
